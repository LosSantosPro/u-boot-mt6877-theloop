# MT6877 (Dimensity 930) CPU-level config fragment.

CONFIG_ARM=y
CONFIG_CPU_V7A=y
CONFIG_SYS_ARCH_TIMER=y
CONFIG_COUNTER_FREQUENCY=13000000
CONFIG_POSITION_INDEPENDENT=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_TEXT_BASE=0x48200000
CONFIG_NR_DRAM_BANKS=1
CONFIG_TARGET_MT6877=y
CONFIG_SYS_LOAD_ADDR=0x48200000
CONFIG_BOARD_INIT=y
CONFIG_CMD_GPT=y
CONFIG_CMD_MMC=y
CONFIG_CMD_PART=y
CONFIG_OF_UPSTREAM=y
CONFIG_CLK=y
CONFIG_MMC_MTK=y
CONFIG_BAUDRATE=921600

# Malloc pool. 256 KB is enough for USB gadget descriptors + fastboot
# metadata; the default 4 MB was kept for historical reasons but the
# allocator never uses more than a few tens of KB during fastboot.
CONFIG_SYS_MALLOC_LEN=0x40000

# Init stack below CONFIG_TEXT_BASE, in DRAM the preloader has initialised.
CONFIG_HAS_CUSTOM_SYS_INIT_SP_ADDR=y
CONFIG_CUSTOM_SYS_INIT_SP_ADDR=0x481ffff0

CONFIG_DM_SERIAL=y
# MediaTek UART driver. Without this, CONFIG_DM_SERIAL=y has no
# backend and printf() / dev_info() output goes nowhere, which hid
# every u-boot log message during the silent-hang debugging.
CONFIG_MTK_SERIAL=y

# ARM SMCCC support — needed for MT6877 USB power-on SMC (0x82000527).
# Kernel calls MTK_SIP_KERNEL_USB_CONTROL to request USB hardware
# resources from ATF; without this, MTU3 MAC stays in partial-power
# state and CAP_EPINFO reads 0.
CONFIG_ARM_SMCCC=y

# PMIC wrapper + MT6359P regulator framework.
# Needed so u-boot's mtu3 driver can enable vusb33 (MT6359P ldo_vusb,
# 3V USB PHY supply) via regulator_set_enable. Without this the supply
# was optional in u-boot and preloader's enabled state doesn't always
# survive the u-boot init.
CONFIG_DM_PMIC=y
CONFIG_DM_PMIC_MTK_PWRAP=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_FIXED=y
CONFIG_DM_REGULATOR_MT6359=y
CONFIG_CMD_REGULATOR=y
