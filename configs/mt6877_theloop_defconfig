#include <configs/mt6877.config>

CONFIG_DEFAULT_DEVICE_TREE="mediatek/mt6877-theloop"
CONFIG_IDENT_STRING="mt6877-theloop"

# USB gadget + fastboot + PHY. Enumerates as 0e8d:201c matching stock LK.
CONFIG_USB=y
CONFIG_USB_MTU3=y
CONFIG_USB_GADGET=y
CONFIG_DM_USB_GADGET=y
CONFIG_PHY=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_GADGET_VENDOR_NUM=0x0e8d
CONFIG_USB_GADGET_PRODUCT_NUM=0x201c
CONFIG_USB_GADGET_MANUFACTURER="theloop pmOS"
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x4d000000
# 128 MiB fastboot buffer, matches stock LK. Ends at 0x55000000 which
# is well inside the 2 GiB DRAM window declared by DT. 16 MiB was too
# small for boot.img (~64 MiB) and nowhere near super.img territory.
CONFIG_FASTBOOT_BUF_SIZE=0x8000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_MMC_DEV=0
CONFIG_CMD_FASTBOOT=y

# No-UART runtime control. Without these, you can only see u-boot output
# via the PCB debug pads (UART). With these, the host can run arbitrary
# u-boot shell commands AND read back the console over the same fastboot
# USB link we already have working.
#
# Correct wire syntax: u-boot's dispatcher splits command name from the
# parameter using ':' (not space), so the host must use the colon form:
#   fastboot oem "run:bootefi bootmgr"    -> run a u-boot command
#   fastboot oem console                  -> dump u-boot's printf buffer
# (the generic "fastboot oem run X" form sends space-separated tokens
#  that the dispatcher treats as one unknown command.)
#
# Buffer size: 64 KiB. One `dm tree` alone is ~200 lines / ~15 KiB of
# output; smaller buffers overflow mid-session and then self-lock
# (console_record_readline returns -ENOSPC once GD_FLG_RECORD_OVF is
# set, and the reset path only fires when the buffer is empty, so it
# can never recover on its own). We also add a local self-heal in
# fb_command.c to clear the overflow state after reporting it.
CONFIG_FASTBOOT_OEM_RUN=y
CONFIG_CONSOLE_RECORD=y
CONFIG_CONSOLE_RECORD_OUT_SIZE=0x10000
CONFIG_FASTBOOT_CMD_OEM_CONSOLE=y

CONFIG_ENV_IS_NOWHERE=y

CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="fastboot 0"
CONFIG_CMD_BOOTI=y
CONFIG_HUSH_PARSER=y
CONFIG_FIT=y
CONFIG_BOOTDELAY=1

# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
